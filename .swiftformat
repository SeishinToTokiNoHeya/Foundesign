# 적용 범위와 수동 확인 항목: docs/guides/code-conventions.md
--min-version 0.58.1
--swift-version 6.4
--exclude .build,.git,.swiftpm,Packages,DerivedData,**/xcuserdata
--markdown-files lenient

# 문법·API를 바꾸는 기본 규칙 대신 공백과 배치 규칙만 적용합니다.
--rules indent,linebreaks,linebreakAtEndOfFile,trailingSpace,consecutiveSpaces,consecutiveBlankLines,blankLinesAtStartOfScope,blankLinesAtEndOfScope,consistentSwitchCaseSpacing,spaceAroundBraces,spaceAroundBrackets,spaceAroundGenerics,spaceAroundOperators,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideGenerics,spaceInsideParens
--indent 2
--tab-width 2
--indent-case false
--linebreaks lf
--trim-whitespace always
